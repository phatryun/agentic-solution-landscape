# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=eu-west-1
AWS_PROFILE=default

# ── Amazon Cognito ────────────────────────────────────────────────────────────
COGNITO_USER_POOL_ID=eu-west-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_ISSUER=https://cognito-idp.eu-west-1.amazonaws.com/eu-west-1_XXXXXXXXX

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (configured in Cognito as federated identity provider)
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Database (RDS PostgreSQL) ─────────────────────────────────────────────────
DATABASE_URL=postgresql://genai_user:password@localhost:5432/genai_landscape

# ── S3 (Second Brain vault) ───────────────────────────────────────────────────
S3_VAULT_BUCKET=genai-landscape-vault

# ── Amazon Bedrock ────────────────────────────────────────────────────────────
BEDROCK_AGENT_ID=XXXXXXXXXX
BEDROCK_AGENT_ALIAS_ID=XXXXXXXXXX
BEDROCK_KNOWLEDGE_BASE_ID=XXXXXXXXXX
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-20250514-v1:0

# ── OpenSearch ────────────────────────────────────────────────────────────────
OPENSEARCH_ENDPOINT=https://xxxxxxxxxxxx.eu-west-1.aoss.amazonaws.com
OPENSEARCH_INDEX=genai-solutions
