# ── Local dev (no AWS required) ───────────────────────────────────────────────
# Copy this file to .env.local to run the app locally without AWS

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Reads vault/ from filesystem instead of S3
USE_LOCAL_VAULT=true

# Explicitly bypass auth REDIRECTS in local dev (API routes still check auth)
BYPASS_AUTH=true

# Dummy NextAuth config (no real Cognito needed for local)
NEXTAUTH_SECRET=local-dev-secret-not-for-production
NEXTAUTH_URL=http://localhost:3000

# Leave empty — secrets resolved from SM_* ARNs in production
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_ISSUER=
DATABASE_URL=postgresql://genai_user:localpassword@localhost:5432/genai_landscape
