# Copy this file to terraform.tfvars and fill in your values
# terraform.tfvars is gitignored — never commit real secrets

aws_region   = "eu-west-1"
aws_profile  = "default"
prefix       = "genai-landscape"
environment  = "dev"

app_url      = "https://main.xxxxxxxxxxxx.amplifyapp.com"

google_client_id     = "xxxx.apps.googleusercontent.com"
google_client_secret = "GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

db_password    = "changeme-strong-password"
nextauth_secret = "run: openssl rand -base64 32"
cron_secret    = "run: openssl rand -hex 32"

# Optional — for Amplify CI/CD
github_repo  = "your-github-username/genai-landscape"
github_token = "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
